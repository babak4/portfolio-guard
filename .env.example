# Copy to .env, fill in the values and run: chmod 600 .env
# .env is git-ignored. Never commit real keys.
#
# Trading212 read-only API keys, one pair per account (Settings > API (Beta)).
# Tick only the read permissions: account data, portfolio, history. No orders.
GUARD_T212_KEY_GIA=
GUARD_T212_SECRET_GIA=
GUARD_T212_KEY_ISA=
GUARD_T212_SECRET_ISA=
