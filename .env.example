# Copy to .env, fill in the values and run: chmod 600 .env
# .env is git-ignored. Never commit real keys.
#
# Trading212 read-only API keys, one pair per account (Settings > API (Beta)).
# Tick only the read permissions: account data, portfolio, history. No orders.
GUARD_T212_KEY_GIA=
GUARD_T212_SECRET_GIA=
GUARD_T212_KEY_ISA=
GUARD_T212_SECRET_ISA=

# Alerts (see the Alerts section of the README). Telegram is the main channel, ntfy the fallback.
GUARD_TELEGRAM_BOT_TOKEN=
GUARD_TELEGRAM_CHAT_ID=
GUARD_NTFY_TOPIC=
GUARD_NTFY_SERVER=

# Dashboard access: set ONE of these (the page refuses to open otherwise).
# Behind Tailscale: the Tailscale logins allowed to open it, comma separated.
GUARD_ALLOWED_USERS=
# Or a password.
GUARD_DASHBOARD_PASSWORD=
